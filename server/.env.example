PORT=5001
# Set to your frontend URL in production (comma-separated if multiple, e.g. https://mycareerpilot.com or * for open CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB connection string (e.g. MongoDB Atlas mongodb+srv://... or local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot

# Must be a unique random string at least 32 characters long
JWT_SECRET=replace_with_a_secure_random_32_character_secret_string

# AI Provider: groq | huggingface | gemini | openai | openrouter | ollama | custom
# Get free high-speed Groq key at https://console.groq.com/keys
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Alternative AI provider keys (optional)
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DAILY_AI_LIMIT=50

# Resume parsing & OCR options (optional)
# Set to true if external OCR binary or service is available for scanned PDFs
OCR_ENABLED=false
MAX_UPLOAD_SIZE_MB=10
